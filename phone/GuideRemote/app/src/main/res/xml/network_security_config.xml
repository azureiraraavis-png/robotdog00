<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 왜 이 파일이 필요한가 ★

    안드로이드는 API 28 부터 **암호화 안 된 http 를 기본으로 막습니다.**
    그런데 로봇은 http://192.168.0.51:9991 — 평문입니다. 그대로 두면
    연결이 실패하는데, 그것도 조용히 실패합니다.

  ★ 왜 IP 하나만 열지 않았는가 ★

    그게 더 좁고 안전합니다. 그런데 로봇의 IP 는 공유기가 정하고,
    바뀝니다 (그래서 find_robot.py 가 있습니다). IP 를 박아두면
    바뀐 날 시연장에서 앱을 다시 빌드해야 합니다.

    그래서 평문을 허용하되, **어차피 이 앱은 로봇 말고는 아무 데도
    말을 걸지 않습니다.** 바깥 서버도, 광고도, 분석도 없습니다.
    화면과 멘트는 앱 안에 들어 있고, 통신 상대는 같은 공유기의
    로봇 하나뿐입니다.

    ※ 그래도 좁히고 싶으면 아래처럼 주소를 지정할 수 있습니다.
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">192.168.0.51</domain>
        </domain-config>
      대역(192.168.0.*)으로는 지정할 수 없습니다 — 주소 하나씩만 됩니다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
